# ---------------------------------------------------------------------------
# Node / frontend build
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Frappe builds bundles into public/dist — generated, never committed.
gatepass_management/public/dist/
gatepass_management/public/build.json
.yarn/

# ---------------------------------------------------------------------------
# Frappe / bench artefacts
#
# Anything below is produced by a running site, not by this app. Committing it
# leaks another site's data or breaks the next person's bench.
# ---------------------------------------------------------------------------
*.log
/logs/
/sites/
/config/
/archived/
*.sql
*.sql.gz
site_config.json
common_site_config.json

# Translations are generated by `bench get-untranslated`; only the curated
# .csv files under gatepass_management/translations/ belong in the repo.
*.mo
*.pot

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
tags
.ctags

# ---------------------------------------------------------------------------
# Secrets — belt and braces.
#
# Nothing in this app should ever need a credential file. These patterns exist
# so an accidental one is caught by git rather than by a security report.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
service-account*.json

# ---------------------------------------------------------------------------
# Internal working documents
#
# The product plan, configuration reference and the analysis of the two
# in-house implementations this app replaces. They contain customer context and
# are not part of the distributed app. Kept in the working tree for the team,
# never published.
# ---------------------------------------------------------------------------
docs/internal/

# Knowledge graph output — regenerated from the source, never distributed.
graphify-out/

# Scratch space
scratch/
tmp/
*.tmp
*.bak
*.orig
*.rej
